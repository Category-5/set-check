# Copy to .env.local for development. On Redbox the same keys live in
# /srv/setcheck/shared/.env (see deploy/README.md).

# Supabase (public: shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server only; never expose). Used for cover
# uploads, page view tracking and /stats.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string; salts visitor hashes. `openssl rand -hex 32`
ANALYTICS_SALT=

# Password for /stats (HTTP Basic auth, any username)
STATS_PASSWORD=

# Music providers
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
